// ==============================================================================
// HUAWEI MOBILE SERVICES (HMS CORE) GRADLE CONFIGURATION FOR GODOT 4.x
// Place these blocks into your Android export project's build.gradle files.
// ==============================================================================

// 1. Root build.gradle (Project level)
buildscript {
    repositories {
        google()
        mavenCentral()
        // Huawei Maven Repository
        maven { url 'https://developer.huawei.com/repo/' }
    }
    dependencies {
        classpath 'com.android.tools.build:gradle:8.2.0'
        // Huawei AppGallery Connect Plugin
        classpath 'com.huawei.agconnect:agcp:1.9.1.300'
    }
}

allprojects {
    repositories {
        google()
        mavenCentral()
        // Huawei Maven Repository
        maven { url 'https://developer.huawei.com/repo/' }
    }
}

// ------------------------------------------------------------------------------

// 2. App-level build.gradle (:app)
apply plugin: 'com.android.application'
// Apply Huawei AppGallery Connect Plugin
apply plugin: 'com.huawei.agconnect'

dependencies {
    // Huawei Account Kit (Progressive On-Demand Sign In)
    implementation 'com.huawei.hms:hwid:6.12.0.300'

    // Huawei Game Service Kit (Leaderboards & Achievements)
    implementation 'com.huawei.hms:game:6.10.0.300'
}
